#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

#define MOTOR_DRIVER_ADDR 0x40  // I2C address of your motor driver
Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver(MOTOR_DRIVER_ADDR);  // Initialize with motor driver address

#define SERVOMIN  150
#define SERVOMAX  600
#define SERVO_FREQ 50

uint8_t activeServos[] = {2, 1, 8, 10, 13, 15};  // List of active servos (you can add more if needed)
const uint8_t numServos = sizeof(activeServos) / sizeof(activeServos[0]);

int joy1XVal, joy1YVal, joy2XVal, joy2YVal, joy3XVal, joy3YVal;
bool joy1SWVal, joy2SWVal, joy3SWVal;

void setup() {
  Serial.begin(9600);
  Serial.println("Slave Ready!");
  
  pwm.begin();
  pwm.setOscillatorFrequency(27000000);
  pwm.setPWMFreq(SERVO_FREQ);
  delay(10);

  Wire.begin(0x8);  // Slave address is 0x8
  Wire.onReceive(receiveEvent);  // Register the function to handle received data
}

void loop() {
  // No need to do anything in the loop for now, just wait for I2C events
  delay(50);
}

void receiveEvent(int bytes) {
  if (Wire.available() >= 12) {
    // Read joystick values for all three joysticks
    joy1XVal = Wire.read() << 8 | Wire.read();  // Combine high and low byte for Joystick 1 X
    joy1YVal = Wire.read() << 8 | Wire.read();  // Combine high and low byte for Joystick 1 Y
    joy2XVal = Wire.read() << 8 | Wire.read();  // Combine high and low byte for Joystick 2 X
    joy2YVal = Wire.read() << 8 | Wire.read();  // Combine high and low byte for Joystick 2 Y
    joy3XVal = Wire.read() << 8 | Wire.read();  // Combine high and low byte for Joystick 3 X
    joy3YVal = Wire.read() << 8 | Wire.read();  // Combine high and low byte for Joystick 3 Y

    // Read switch states (only 1 byte for each)
    joy1SWVal = Wire.read();
    joy2SWVal = Wire.read();
    joy3SWVal = Wire.read();

    // Print the received values for debugging
    Serial.print("Joy1 X: "); Serial.print(joy1XVal);
    Serial.print(" Joy1 Y: "); Serial.print(joy1YVal);
    Serial.print(" Joy2 X: "); Serial.print(joy2XVal);
    Serial.print(" Joy2 Y: "); Serial.print(joy2YVal);
    Serial.print(" Joy3 X: "); Serial.print(joy3XVal);
    Serial.print(" Joy3 Y: "); Serial.print(joy3YVal);
    Serial.print(" Joy1 SW: "); Serial.print(joy1SWVal);
    Serial.print(" Joy2 SW: "); Serial.print(joy2SWVal);
    Serial.print(" Joy3 SW: "); Serial.println(joy3SWVal);

    // Map joystick X, Y values for joystick 3 to servo range
    int servoPos = map(joy3XVal, 0, 1023, SERVOMIN, SERVOMAX);  // Use X-axis for controlling position
    int servoPosY = map(joy3YVal, 0, 1023, SERVOMIN, SERVOMAX); // Use Y-axis for additional control

    // Control servo on channel 15 with joystick 3 data
    pwm.setPWM(15, 0, servoPos);  // Control servo with joystick 3 X-axis
    pwm.setPWM(15, 0, servoPosY); // Optionally, use Y-axis for another control (e.g., different servo or more complex behavior)
  }
}
