#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>
#include <AlignedJoy.h>  // Include AlignedJoy library

// Define PCA9685 object
Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver();

// Define joystick pins (assuming analog joystick)
const int joy1X = A0;
const int joy1Y = A1;  // Y-axis for joystick 1
const int joy2X = A2;
const int joy2Y = A3;  // Y-axis for joystick 2

// Define servo channel pins for PCA9685
const int servo1 = 0; // Servo 1 on channel 0 of PCA9685

// Variable to store last servo position
int lastServo1Pos = 500; // Start at the leftmost position (500 microseconds)

void setup() {
  // Initialize serial communication
  Serial.begin(9600);

  // Initialize PCA9685
  pwm.begin();
  pwm.setPWMFreq(60); // Set frequency to 60Hz
}

void loop() {
  // Read joystick Y-axis value
  int joy1YVal = analogRead(joy1Y);  // Y-axis value from joystick 1 (up/down)

  // Map joystick Y-axis values (0-1023) to PWM values (500-2500 for 270-degree servo)
  int servo1Pos = map(joy1YVal, 0, 1023, 500, 2500); // Adjusted for 270-degree range

  // Only update the servo position if the joystick is moved (not released)
  if (joy1YVal < 512 || joy1YVal > 512) {
    lastServo1Pos = servo1Pos;  // Update the last position if joystick is moved
  }

  // Set the position of Servo 1 based on joystick 1's Y-axis input
  pwm.writeMicroseconds(servo1, lastServo1Pos);

  // Debugging: Print joystick value and corresponding servo position
  Serial.print("Joy1 Y: ");
  Serial.print(joy1YVal);
  Serial.print(", Servo 1 Position: ");
  Serial.println(lastServo1Pos);

  delay(100); // Small delay for smooth movement
}
