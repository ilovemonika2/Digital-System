#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver();  // Create PCA9685 object

int joy1XVal, joy1YVal, joy2XVal, joy2YVal, joy3XVal, joy3YVal;

// Define the deadzone size (e.g., ±100 units from center)
const int deadzone = 100;
const int centerValue = 512;

// **Last known servo positions (Start at neutral)**
int servo1LastPos = 1500;
int servo2LastPos = 1500;
int servo3LastPos = 1500;
int servo4LastPos = 1500;
int servo5LastPos = 1500;
int servo6LastPos = 1500;

// **Movement scaling factors**
const int joystickScale = 8;  // Adjusts sensitivity for joystick-controlled servos

void setup() {
  Serial.begin(9600);
 
  Wire.begin(8);  // Join I2C bus as slave with address 8
  Wire.onRequest(requestEvent);  // Called when master requests data
  Wire.onReceive(receiveEvent);  // Called when data is received
 
  pwm.begin();  // Initialize the PCA9685 module
  pwm.setPWMFreq(60);  // Set PWM frequency to 60Hz for servos
}


void loop() {
  // **Servo 1 Movement (Joystick 1 X)**
  if (abs(joy1XVal - centerValue) > deadzone) {
    servo1LastPos += (joy1XVal - centerValue) / joystickScale;
  }
 
  // **Servo 2 Movement (Joystick 1 Y)**
  if (abs(joy1YVal - centerValue) > deadzone) {
    servo2LastPos += (joy1YVal - centerValue) / joystickScale;
  }


  // **Servo 3 Movement (Joystick 2 X)**
  if (abs(joy2XVal - centerValue) > deadzone) {
    servo3LastPos += (joy2XVal - centerValue) / joystickScale;
  }


  // **Servo 4 Movement (Joystick 2 Y)**
  if (abs(joy2YVal - centerValue) > deadzone) {
    servo4LastPos += (joy2YVal - centerValue) / joystickScale;
  }


  // **Servo 5 Movement (Joystick 2 Y)**
  if (abs(joy3YVal - centerValue) > deadzone) {
    servo5LastPos += (joy3YVal - centerValue) / joystickScale;
  }


  // **Servo 6 Movement (Joystick 2 Y)**
  if (abs(joy3XVal - centerValue) > deadzone) {
    servo6LastPos += (joy3XVal - centerValue) / joystickScale;
  }

  // **Clamp values to prevent out-of-range motion**
  servo1LastPos = constrain(servo1LastPos, 500, 2500);
  servo2LastPos = constrain(servo2LastPos, 500, 2500);
  servo3LastPos = constrain(servo3LastPos, 500, 2500);
  servo4LastPos = constrain(servo4LastPos, 500, 2500);
  servo5LastPos = constrain(servo5LastPos, 500, 2500);
  servo6LastPos = constrain(servo6LastPos, 500, 2500);



  // **Send updated positions to servos**
  pwm.writeMicroseconds(2, servo1LastPos);
  pwm.writeMicroseconds(4, servo2LastPos);
  pwm.writeMicroseconds(8, servo3LastPos);
  pwm.writeMicroseconds(10, servo4LastPos);
  pwm.writeMicroseconds(13, servo5LastPos);  // Servo 5 on channel 8
  pwm.writeMicroseconds(15, servo6LastPos);


  delay(50);
}


void receiveEvent(int howMany) {
  joy1XVal = (Wire.read() << 8) | Wire.read(); // Receive X value for Joystick 1
  joy1YVal = (Wire.read() << 8) | Wire.read(); // Receive Y value for Joystick 1

  joy2XVal = (Wire.read() << 8) | Wire.read(); // Receive X value for Joystick 2
  joy2YVal = (Wire.read() << 8) | Wire.read(); // Receive Y value for Joystick 2

  joy3XVal = (Wire.read() << 8) | Wire.read(); // Receive X value for Joystick 3
  joy3YVal = (Wire.read() << 8) | Wire.read(); // Receive Y value for Joystick 3
}


