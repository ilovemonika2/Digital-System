#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

#define SERVOMIN  150 // Minimum pulse length
#define SERVOMAX  600 // Maximum pulse length

Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver(0x40);

int servoChannels[] = {2, 4, 8, 10, 13, 15};
int numServos = sizeof(servoChannels) / sizeof(servoChannels[0]);

void setup() {
    Serial.begin(115200);
    pwm.begin();
    pwm.setPWMFreq(50); // Analog servos typically run at 50 Hz
    delay(10);
}

void moveServo(int channel, int position) {
    int pulseLength = map(position, 0, 180, SERVOMIN, SERVOMAX);
    pwm.setPWM(channel, 0, pulseLength);
}

void smoothMoveServo(int channel, int startAngle, int endAngle, int stepDelay) {
    int step = (startAngle < endAngle) ? 1 : -1;
    for (int angle = startAngle; angle != endAngle; angle += step) {
        moveServo(channel, angle);
        delay(stepDelay);
    }
    moveServo(channel, endAngle); // Ensure it reaches the final position
}

void loop() {
    for (int i = 0; i < numServos; i++) {
        smoothMoveServo(servoChannels[i], 0, 180, 10); // Smoother transition with smaller delay
        smoothMoveServo(servoChannels[i], 180, 0, 10);
    }
}
